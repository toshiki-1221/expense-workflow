meta {
  name: ListApprovals
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/approvals
  body: none
  auth: inherit
}

tests {
  test("200 で自分宛ての申請中だけが古い順に返る", function () {
    expect(res.status).to.equal(200);
    expect(res.body.reports).to.be.an("array");
    res.body.reports.forEach(function (r) {
      expect(r.status).to.equal("submitted");
      expect(r.user.name).to.be.a("string");
    });
  });
}

docs {
  承認者の sato@example.com でログインして実行する（yamada の承認者が sato）。
  承認者になっていない人（yamada・経理）は空の配列が返る。

  - 自分宛て（approver_id = 自分）かつ申請中（submitted）だけ
  - 申請日時の古い順（先に出たものから処理する）
  - 自分の一覧と違い、誰の申請かを user: {id, name} で返す
}

settings {
  encodeUrl: true
  timeout: 0
}
